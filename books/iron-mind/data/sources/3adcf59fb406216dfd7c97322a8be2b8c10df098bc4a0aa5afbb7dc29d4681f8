      {
        "id": "import-fa872bf9ef3ff7c9-run-003-0e74008bd8e8",
        "title": "7-star-wars-provenance.json",
        "content": "{\n  \"schema_version\":\"1.0.0\",\"book_id\":\"run-003\",\"records\":[\n    {\"id\":\"b3-web-era-boundary\",\"record_kind\":\"external-claim\",\"research_question\":\"Is the user window 70-40 years before Anakin still the official High Republic era?\",\"source_type\":\"web-official\",\"source_title\":\"What Is Star Wars: The High Republic?\",\"branch\":\"Canon\",\"source_era\":\"official High Republic overview\",\"locator\":{\"kind\":\"web\",\"url\":\"https://www.starwars.com/news/what-is-star-wars-the-high-republic\",\"accessed_at\":\"2026-08-27\"},\"statement\":\"Official High Republic stories range roughly 150-300 years before Anakin's birth; Book 3's 70-40 window is later, so High Republic material is background/comparator rather than direct target-era proof.\",\"confidence\":\"high\",\"disposition\":\"accepted\",\"era_dependency\":\"era-dependent\",\"target_time_window\":{\"start_years_before_birth\":70,\"end_years_before_birth\":40},\"comparison_category\":\"historical-memory\",\"comparison_status\":\"absent\",\"target_era_evidence\":[\"b3-web-era-boundary\"],\"relevance_tags\":[\"era\",\"boundary\"],\"narrative_uses\":[{\"function\":\"historical-consequence\",\"goal\":\"prevent importing an earlier golden-age condition into direct Book 3 action\",\"location\":\"all target-era planning\",\"pov\":\"author/QC\",\"use_statement\":\"Research scene-critical institutions in the later target window or leave them unknown.\"}],\"conflicts\":[\"Active project files call the 112-BBY context High Republic-adjacent; official era labeling places the user-relative Book 3 window later.\"]},\n    {\"id\":\"b3-web-jedi-attention\",\"record_kind\":\"external-claim\",\"research_question\":\"What can earlier official material safely contribute about Jedi presence and Force perception?\",\"source_type\":\"web-official\",\"source_title\":\"The Makers of Star Wars: The High Republic: Charles Soule\",\"branch\":\"Canon\",\"source_era\":\"earlier High Republic comparator\",\"locator\":{\"kind\":\"web\",\"url\":\"https://www.starwars.com/news/the-makers-of-star-wars-the-high-republic-charles-soule\",\"accessed_at\":\"2026-08-27\"},\"statement\":\"In the earlier era many Jedi respond to localized problems and experience the Force in individual ways; this supports varied interpretation, not automatic recognition of Perun or target-window deployment numbers.\",\"confidence\":\"high\",\"disposition\":\"adapted\",\"adaptation_note\":\"Use only to keep a Force-sensitive observer's reading personal and uncertain.\",\"era_dependency\":\"era-dependent\",\"target_time_window\":{\"start_years_before_birth\":70,\"end_years_before_birth\":40},\"comparison_category\":\"jedi-force\",\"comparison_status\":\"transitional\",\"target_era_evidence\":[\"b3-web-era-boundary\",\"b3-web-jedi-attention\"],\"relevance_tags\":[\"jedi\",\"force\",\"attention\"],\"narrative_uses\":[{\"function\":\"wonder\",\"goal\":\"make unexplained attention constrain a profitable plan\",\"location\":\"weak-query and later audit scenes\",\"pov\":\"Force-sensitive observer / Perun through a report\",\"use_statement\":\"The observer notices an effect and may be wrong; Perun learns only the transmitted query.\"}],\"conflicts\":[]},\n    {\"id\":\"b3-web-culture-politics\",\"record_kind\":\"external-claim\",\"research_question\":\"How can systems and cultures remain distinct inside a large Republic?\",\"source_type\":\"web-official\",\"source_title\":\"Daniel Jose Older on Race to Crashpoint Tower\",\"branch\":\"Canon\",\"source_era\":\"earlier High Republic comparator\",\"locator\":{\"kind\":\"web\",\"url\":\"https://www.starwars.com/news/daniel-jose-older-race-to-crashpoint-tower-interview\",\"accessed_at\":\"2026-08-27\"},\"statement\":\"Republic growth involves infrastructure and many worlds displaying distinct cultures; political inclusion does not erase local identity.\",\"confidence\":\"medium\",\"disposition\":\"adapted\",\"adaptation_note\":\"Use diversity as independent goals and bargaining pressure, not decorative species detail or proof of later procedures.\",\"era_dependency\":\"era-dependent\",\"target_time_window\":{\"start_years_before_birth\":70,\"end_years_before_birth\":40},\"comparison_category\":\"cultures-languages-etiquette\",\"comparison_status\":\"transitional\",\"target_era_evidence\":[\"b3-web-era-boundary\",\"b3-web-culture-politics\"],\"relevance_tags\":[\"cultures\",\"politics\",\"infrastructure\"],\"narrative_uses\":[{\"function\":\"cultural-friction\",\"goal\":\"make each house, station and owner impose a distinct practical condition\",\"location\":\"regional expansion\",\"pov\":\"Perun and external POVs\",\"use_statement\":\"Culture changes consent, legitimacy, risk and obligation in the current conflict.\"}],\"conflicts\":[]},\n    {\"id\":\"b3-web-kyber-sacred\",\"record_kind\":\"external-claim\",\"research_question\":\"What does official material establish about kyber crystals before Perun treats one as engineering material?\",\"source_type\":\"web-official\",\"source_title\":\"Kyber Crystal (Lightsaber Crystal) | Star Wars Databank\",\"branch\":\"Canon\",\"source_era\":\"era-invariant reference\",\"locator\":{\"kind\":\"web\",\"url\":\"https://www.starwars.com/databank/lightsaber-crystal\",\"accessed_at\":\"2026-09-04\"},\"statement\":\"The official Databank places a kyber crystal at the heart of every Jedi lightsaber, says kyber crystals are found on several planets and describes a personal Force attunement between a specific crystal and a Jedi. Kyber crystals are therefore a class of objects rather than one unique relic; the individual bond and properties of a particular specimen may be distinctive.\",\"confidence\":\"high\",\"disposition\":\"adapted\",\"adaptation_note\":\"Perun's difficulty is obtaining and using a suitable intact specimen without exposing himself, not the uniqueness of kyber crystals as a class. Project canon allows a specially processed kyber crystal to operate only as a non-native surrogate in the archaeotech droid. The native power energy crystals are a separate project-specific technology unrelated to kyber crystals or the Force. By direct author decision, first contact through the installed processed kyber teaches Perun's main multidimensional body to use the Force; the acquired ability persists without the crystal and can act through effector-controlled bodies. The droid brains do not become independently Force-sensitive, and ordinary network machines do not inherit this ability. The artifact is Perun's former armor, a closed author truth; its native personal-computation expansion requires native crystals and is not activated by the surrogate. These mechanisms are project adaptations, not claims established by the external source.\",\"era_dependency\":\"era-invariant\",\"target_time_window\":{\"start_years_before_birth\":70,\"end_years_before_birth\":40},\"comparison_category\":\"not-applicable\",\"comparison_status\":\"same\",\"target_era_evidence\":[\"b3-web-kyber-sacred\"],\"relevance_tags\":[\"kyber-crystal\",\"lightsaber\",\"jedi\",\"surrogate\",\"power-energy-crystal\"],\"narrative_uses\":[{\"function\":\"wonder\",\"goal\":\"separate the processed kyber-crystal surrogate from the archaeotech droid's native power energy crystals\",\"location\":\"archaeotech droid and auction trail\",\"pov\":\"Perun\",\"use_statement\":\"Ground the kyber crystal in Star Wars canon, mark its processed use as a surrogate, and never transfer its Force properties to the native power energy crystals.\"}],\"conflicts\":[\"The surrogate application of a processed kyber crystal has no external proof and is project-specific.\",\"The native Heart, Mirror and Beacon power energy crystals are not kyber crystals and have no relation to the Force.\"]},\n    {\"id\":\"b3-web-bomarr-existence\",\"record_kind\":\"external-claim\",\"research_question\":\"What external fact bounds the AU B'omarr-derived houses?\",\"source_type\":\"web-official\",\"source_title\":\"Teth Monastery | Star Wars Databank\",\"branch\":\"Canon\",\"source_era\":\"B'omarr site exists before later Clone Wars use\",\"locator\":{\"kind\":\"web\",\"url\":\"https://www.starwars.com/databank/teth-monastery\",\"accessed_at\":\"2026-08-27\"},\"statement\":\"Official material identifies a Teth monastery as a former sacred temple of the B'omarr; it does not establish Perun's cybermonastic houses, wandering branch, doctrine or regional membership.\",\"confidence\":\"high\",\"disposition\":\"reference-only\",\"era_dependency\":\"era-dependent\",\"target_time_window\":{\"start_years_before_birth\":70,\"end_years_before_birth\":40},\"comparison_category\":\"cultures-languages-etiquette\",\"comparison_status\":\"unknown\",\"target_era_evidence\":[\"b3-web-bomarr-existence\"],\"relevance_tags\":[\"bomarr\",\"religion\",\"au\"],\"narrative_uses\":[{\"function\":\"cultural-friction\",\"goal\":\"make real B'omarr scrutiny a limit on Perun's created branch\",\"location\":\"house verification\",\"pov\":\"B'omarr observer and Perun through a letter\",\"use_statement\":\"Recognition can be partial and conditional; the AU institution earns legitimacy through conduct.\"}],\"conflicts\":[]},\n    {\"id\":\"b3-web-rendili-index\",\"record_kind\":\"external-claim\",\"research_question\":\"Is the plan's exact Rendili expansion and licensing model externally established?\",\"source_type\":\"web-index\",\"source_title\":\"Rendili StarDrive/Legends | Wookieepedia\",\"branch\":\"Legends\",\"source_era\":\"index places a Dreadnaught-class milestone around 100 BBY\",\"locator\":{\"kind\":\"web\",\"url\":\"https://starwars.fandom.com/wiki/Rendili_StarDrive/Legends\",\"accessed_at\":\"2026-08-27\"},\"statement\":\"The index supports Rendili as an established shipbuilder and points to a major product around 100 BBY, but it is not admissible proof for the plan's licensing network, audit rules, percentages or political response.\",\"confidence\":\"medium\",\"disposition\":\"reference-only