{
  "name": "writer-helper",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --dev",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1",
    "test": "node --test tests/*.test.js",
    "test:startup": "node tests/startup.js",
    "test:fragments": "node tests/manuscript-generation-ui.js",
    "import:json": "node scripts/import-json.js",
    "book:publish": "node scripts/publish-book.js",
    "test:preview-dirty": "node tests/preview-dirty-ui.js",
    "test:drafts-audit": "node tests/all-section-drafts-ui.js"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "description": "Локальное рабочее место автора: книги, главы, сцены, рукописи и помощь ИИ."
}
